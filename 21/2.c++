#include <iostream>
#include <cmath>
using namespace std;

int main() {
    double x = 9.0;
    cout << "sqrt(9) = " << sqrt(x) << endl;     // 平方根
    cout << "pow(2,3) = " << pow(2, 3) << endl;  // 幂运算
    cout << "ceil(2.3) = " << ceil(2.3) << endl; // 向上取整
    cout << "floor(2.7) = " << floor(2.7) << endl;// 向下取整
    cout << "abs(-5) = " << abs(-5) << endl;     // 绝对值
    return 0;
}